/**
* @brief: ClearCpuInterrupt
* @param: void
* @return:Nothing
* @note:清除CPU中断标志位
*/
void ClearClaInterrupt(void)
{
    /*清除中断标志,且对下次中断发出请求*/
    EPwm11Regs.ETCLR.bit.INT = 1;
    PieCtrlRegs.PIEACK.all = PIEACK_GROUP3;
}
