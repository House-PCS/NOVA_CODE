    // SetClaDebugData(11,gstAlgoInterface.grid_cur_rms);
    // SetClaDebugData(12,gstAlgoInterface.inv_cur_rms);
    // SetClaDebugData(13,gstAlgoInterface.ct_cur_rms);
    // SetClaDebugData(14,gstAlgoInterface.load_vol_rms);
    // SetClaDebugData(15, gstAlgoInterface.generator_vol_rms);
 
//    SetClaDebugData(10, gstPowerGiven.pv_pwr);
    // SetClaDebugData(11, gstCurrentLoop.Out_pi);
    // SetClaDebugData(11, -1.0f*gstAdcResult.inv_curr_tol);
    // SetClaDebugData(12, gAddCur);
    // SetClaDebugData(14,gstAdcZero.inv_curr_tol_zero);
    // SetClaDebugData(15,gstAdcZero.inv_L_curr_zero);
    //功角计算

    SinglePhasePLL(&gstGrid.curr);
    SinglePhasePLL(&gstInv.curr);
    SinglePhasePLL(&gstGenerator.curr);
    SinglePhasePLL(&gstCT.curr);
    SinglePhasePLL(&gstNormalLoad.curr);
    SinglePhasePLL(&gstBackUp.curr);
    gstGrid.power.power_factor = gstGrid.curr.pll.cos0 * gstGrid.volt.pll.cos0 + gstGrid.curr.pll.sin0 * gstGrid.volt.pll.sin0;
    gstGrid.power.power_refactor = - gstGrid.curr.pll.sin0 * gstGrid.volt.pll.cos0 + gstGrid.curr.pll.cos0 * gstGrid.volt.pll.sin0;
    gstInv.power.power_factor = gstInv.curr.pll.cos0 * gstInv.volt.pll.cos0 + gstInv.curr.pll.sin0 * gstInv.volt.pll.sin0;
    gstInv.power.power_refactor = - gstInv.curr.pll.sin0 * gstInv.volt.pll.cos0 + gstInv.curr.pll.cos0 * gstInv.volt.pll.sin0;
    gstGenerator.power.power_factor = gstGenerator.curr.pll.cos0 * gstGenerator.volt.pll.cos0 + gstGenerator.curr.pll.sin0 * gstGenerator.volt.pll.sin0;
    gstGenerator.power.power_refactor = - gstGenerator.curr.pll.sin0 * gstGenerator.volt.pll.cos0 + gstGenerator.curr.pll.cos0 * gstGenerator.volt.pll.sin0;
    gstBackUp.power.power_factor = gstBackUp.curr.pll.cos0 * gstInv.volt.pll.cos0 + gstBackUp.curr.pll.sin0 * gstInv.volt.pll.sin0;
    gstBackUp.power.power_refactor = - gstBackUp.curr.pll.sin0 * gstInv.volt.pll.cos0 + gstBackUp.curr.pll.cos0 * gstInv.volt.pll.sin0;
    gstCT.power.power_factor = gstCT.curr.pll.cos0 * gstGrid.volt.pll.cos0 + gstCT.curr.pll.sin0 * gstGrid.volt.pll.sin0;
    gstCT.power.power_refactor = - gstCT.curr.pll.sin0 * gstGrid.volt.pll.cos0 + gstCT.curr.pll.cos0 * gstGrid.volt.pll.sin0;
    gstNormalLoad.power.power_factor = gstNormalLoad.curr.pll.cos0 * gstGrid.volt.pll.cos0 + gstNormalLoad.curr.pll.sin0 * gstGrid.volt.pll.sin0;
    gstNormalLoad.power.power_refactor = - gstNormalLoad.curr.pll.sin0 * gstGrid.volt.pll.cos0 + gstNormalLoad.curr.pll.cos0 * gstGrid.volt.pll.sin0;

    /*  有效值计算   */
    RmsPwrClaCalcStep(&gstInvData, gstInv.volt.value.instant, gstInv.curr.value.instant, gstInv.power.power_refactor);
    RmsPwrClaCalcStep(&gstGridData, gstGrid.volt.value.instant, gstGrid.curr.value.instant, gstGrid.power.power_refactor);
    RmsPwrClaCalcStep(&gstGeneratorData, gstGenerator.volt.value.instant, gstGenerator.curr.value.instant, gstGenerator.power.power_refactor);
    RmsPwrClaCalcStep(&gstBackUpData, gstBackUp.volt.value.instant, gstBackUp.curr.value.instant, gstBackUp.power.power_refactor);
    RmsPwrClaCalcStep(&gstCTData, gstCT.volt.value.instant, gstCT.curr.value.instant, gstCT.power.power_refactor);
    RmsPwrClaCalcStep(&gstNormalLoadData, gstNormalLoad.volt.value.instant, gstNormalLoad.curr.value.instant, gstNormalLoad.power.power_refactor);
    gstInv.volt.value.rms = gstInvData.vol_rms;
    gstInv.curr.value.rms = gstInvData.cur_rms;
    gstInv.power.all = gstInvData.pwr_apperant_out;
    gstInv.power.p = gstInvData.pwr_active_out;
    gstInv.power.q = gstInvData.pwr_reactive_out;

    gstGrid.volt.value.rms = gstGridData.vol_rms;
    gstGrid.curr.value.rms = gstGridData.cur_rms;
    gstGrid.power.all = gstGridData.pwr_apperant_out;
    gstGrid.power.p = gstGridData.pwr_active_out;
    gstGrid.power.q = gstGridData.pwr_reactive_out;

    gstGenerator.volt.value.rms = gstGeneratorData.vol_rms;
    gstGenerator.curr.value.rms = gstGeneratorData.cur_rms;
    gstGenerator.power.all = gstGeneratorData.pwr_apperant_out;
    gstGenerator.power.p = gstGeneratorData.pwr_active_out;
    gstGenerator.power.q = gstGeneratorData.pwr_reactive_out;

    gstInv.volt.value.average = gstInvData.vol_avg;
    gstGrid.volt.value.average = gstGridData.vol_avg;
    gstGenerator.volt.value.average = gstGeneratorData.vol_avg;

    gstBackUp.volt.value.rms = gstBackUpData.vol_rms;
    gstBackUp.curr.value.rms = gstBackUpData.cur_rms;
    gstBackUp.power.all = gstBackUpData.pwr_apperant_out;
    gstBackUp.power.p = gstBackUpData.pwr_active_out;
    gstBackUp.power.q = gstBackUpData.pwr_reactive_out;
    gstBackUp.power.q_filter = 0.00005f * gstBackUp.power.q + 0.99995f * gstBackUp.power.q_filter;

    gstCT.volt.value.rms = gstCTData.vol_rms;
    gstCT.curr.value.rms = gstCTData.cur_rms;
    gstCT.power.all = gstCTData.pwr_apperant_out;
    gstCT.power.p = gstCTData.pwr_active_out;
    gstCT.power.q = gstCTData.pwr_reactive_out;
    
    gstNormalLoad.volt.value.rms = gstNormalLoadData.vol_rms;
    gstNormalLoad.curr.value.rms = gstNormalLoadData.cur_rms;
    gstNormalLoad.power.all = gstNormalLoadData.vol_rms * gstNormalLoadData.cur_rms;
    gstNormalLoad.power.p = gstCT.power.p - gstGrid.power.p;
    gstNormalLoad.power.q = gstCT.power.q - gstGrid.power.q;
}
/**
* @brief: SinglePhasePwmUpDate
* @param: static inline void
* @return:Nothing
* @note:
*/
static inline void SinglePhasePwmUpDate(float duty, uint16_t en_inv)
{
    Uint16  Duty_ticks_pos = 0;
    float32 duty_temp;
    float32 duty_eff;

    duty_temp = VALUE_LIMIT(duty,0.95f,-0.95f);
    /***********************************/
    duty_temp = duty_temp + gDuty_err;
    /***********************************/
    if(duty_temp > -0.05f && duty_temp < 0.05f)
    {
        duty_eff = 0.0f;
    }
    else
    {
        duty_eff = duty_temp;
    }
    gDuty_err = (duty_temp - duty_eff);
    if(en_inv == 0)
    {
        GpioDataRegs.GPBCLEAR.bit.GPIO45    = 1;//置低
        EPwm2Regs.CMPA.bit.CMPA = EPwm2Regs.TBPRD; //占空比清零
        EPwm1Regs.CMPA.bit.CMPA = EPwm2Regs.TBPRD; //占空比清零
    }
    else
    {
        GpioDataRegs.GPBSET.bit.GPIO45    = 1;//置高
        Duty_ticks_pos  = (Uint16)((float)(EPwm2Regs.TBPRD) * (1.0f - fabsf(duty_eff)));
        EPwm2Regs.CMPA.bit.CMPA = Duty_ticks_pos; 
        EPwm1Regs.CMPA.bit.CMPA = Duty_ticks_pos; 

        if(duty_eff > 0.0f)
        {
            EPwm2Regs.AQCSFRC.bit.CSFA = AQ_NO_ACTION;
            EPwm1Regs.AQCSFRC.bit.CSFA = AQ_CLEAR;
        }
        else
        {
            EPwm2Regs.AQCSFRC.bit.CSFA = AQ_CLEAR;
            EPwm1Regs.AQCSFRC.bit.CSFA = AQ_NO_ACTION;
        }
    }
}
/**
* @brief: SinglePhaseOpen
* @param: static inline void
* @return:Nothing
* @note:单相开环控制
*/
static inline void SinglePhaseOpen(ClaType_t* value)
{
    //开环软起
    if(gstInvLoop.disconnect_volt.ref_amplitude > gstInvLoop.disconnect_volt.ref_amplitude_eff)
    {
        gstInvLoop.disconnect_volt.ref_amplitude_eff += DELTA_VOLTAGE_STEP;
    }
    else
    {
        gstInvLoop.disconnect_volt.ref_amplitude_eff = gstInvLoop.disconnect_volt.ref_amplitude;
    }
    gstInvLoop.disconnect_volt.ref_real = gstInvLoop.disconnect_volt.ref_amplitude_eff * gstSinCosSignal.sin_eff[0];

    gstInvLoop.duty = CLAdiv(gstInvLoop.disconnect_volt.ref_real , 500); //TODO:后续更改为bus电压

}
/**
* @brief: InvLoopClear
* @param: void
* @return:Nothing
* @note:逆变环路清除
*/
static void InvLoopClear(void)
{
    //TODO:仅清除离网模式下环路，后续需清除并网下环路

    /*      真实给定值清零      */
    gstInvLoop.disconnect_volt.ref_amplitude_eff = 0.0f;
    gstInvLoop.disconnect_volt.ref_real = 0.0f;
    /*    环路的迭代值清零   */
    gstInvLoop.disconnect_volt.err1 = 0.0f;
    gstInvLoop.disconnect_volt.out1 = 0.0f;

    gstCurrentLoop.delta = 0.0f;
    gstCurrentLoop.erro = 0.0f;
    gstCurrentLoop.erro_up = 0.0f;
    gstCurrentLoop.Out = 0.0f;
    gstCurrentLoop.Out_pi = 0.0f;

    gstInvLoop.disconnect_volt.err1 = 0.0f;
    gstInvLoop.disconnect_volt.err2 = 0.0f;
    gstInvLoop.disconnect_volt.out1 = 0.0f;
    gstInvLoop.disconnect_volt.out2 = 0.0f;
    gstInvLoop.duty = 0.0f;
    gstInvLoop.en_inv = 0;
    gstInvLoop.inv_start_ok = 0;
}
static void VoltRefAmpUpdata(void)
{
    if((gstSinCosSignal.sin_eff[0] < 0.05f) && (gstSinCosSignal.sin_eff[0] > -0.05f))//TODO:过零点生效
    {
        if(fabs(gstInvLoop.disconnect_volt.ref_amplitude - gstInvLoop.disconnect_volt.ref_amplitude_eff) < DELTA_VOLTAGE_STEP)
        {
            gstInvLoop.disconnect_volt.ref_amplitude_eff = gstInvLoop.disconnect_volt.ref_amplitude;
            if(gstInvLoop.disconnect_volt.ref_amplitude_eff == INV_VOL_NORMAL )
            {
                gstInvLoop.inv_start_ok = 1;
            }
        }
        else if(gstInvLoop.disconnect_volt.ref_amplitude > gstInvLoop.disconnect_volt.ref_amplitude_eff)
        {
            gstInvLoop.disconnect_volt.ref_amplitude_eff += DELTA_VOLTAGE_STEP;
        }
        else
        {
            gstInvLoop.disconnect_volt.ref_amplitude_eff -= DELTA_VOLTAGE_STEP;
        }
    }
    //电压给定
    gstInvLoop.disconnect_volt.ref_real = gstInvLoop.disconnect_volt.ref_amplitude_eff * gstSinCosSignal.sin_eff[0];
}
/**
* @brief: SinglePhaseClose
* @param: static inline void
* @return:Nothing
* @note:单相离网闭环控制
*/
static inline void SinglePhaseClose(void)
{
    float32 vol_out = 0;
    float32 bus_vol = 0;
    float32 forward = 0.0f;
    float32 ic_forward = 0.0f;
    float32 feed_back = 0.0f;
    // bus_vol = gstBusPos.volt.instant;
    bus_vol = gstBusPos.volt.instant;//TODO:后续更改为bus电压
    VoltRefAmpUpdata(); //电压给定更新
    //电压环PR控制
    if(gInvDisconnectCount >= DISCONNECTCOUNTTRIGG)
    {
        feed_back = gstInv.volt.value.instant;
    }
    else
    {
        feed_back = gstInvLoop.disconnect_volt.ref_real + (gstInvLoop.disconnect_volt.ref_real - gstInv.volt.value.instant) *(0.1f + 0.9f * gInvDisconnectCount / DISCONNECTCOUNTTRIGG);
        gInvDisconnectCount += 1.0f;
    }
    SinglePhase_PR_Control(&gstInvLoop.disconnect_volt,gstInvLoop.disconnect_volt.ref_real,feed_back);
    ic_forward = -4.5f * gAddCur;
    if(ic_forward > 5.0f)
    {
        ic_forward = 5.0f;
    }
    if(ic_forward < -5.0f)
    {
        ic_forward = -5.0f;
    }
    forward = ic_forward + gstInvLoop.disconnect_volt.ref_real; 
    // gstInvLoop.disconnect_curr.ref_real = AddPIControlerForward(&gstVoltageLoop,gstInvLoop.disconnect_volt.ref_real,gstInv.volt.value.instant, 0);
    gstInvLoop.disconnect_curr.ref_real = gstInvLoop.disconnect_volt.out;
    //电流环PR控制
    vol_out = PIControlerForward(&gstCurrentLoop, gstInvLoop.disconnect_curr.ref_real, gstInv.curr.value.instant, forward);
    //输出限幅
    gstInvLoop.duty = CLAdiv(vol_out, bus_vol); 
    //发波
}

