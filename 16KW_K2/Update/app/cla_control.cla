/**
* @brief: PI_Control
* @param: static inline void
* @return:Nothing
* @note:PI控制
*/
// static inline void SinglePhase_PI_Control(ClaPiLoop_t* loop,float32 ref,float32 feedback)
// {
//     loop->err = ref - feedback;
//     loop->out = -1 * loop->a1 * loop->out1 + loop->b0 * loop->err + loop->b1 * loop->err1;
//     //迭代
//     loop->out1 = loop->out;
//     loop->err1 = loop->err;
// }
/**
* @brief: PR_Control
* @param: static inline void
* @return:Nothing
* @note:PR控制
*/
static inline void SinglePhase_PR_Control(ClaPrLoop_t* loop,float32 ref,float32 feedback)
{
    loop->err = ref - feedback;
    loop->out = loop->a0 * loop->err + loop->a1 * loop->err1 + loop->a2 * loop->err2 - loop->b1 * loop->out1 -loop->b2 * loop->out2;
    if(loop->out > loop->Umax)
    {
        loop->out = loop->Umax;
    }
    if(loop->out < loop->Umin)
    {
        loop->out = loop->Umin;
    }
    //迭代
    loop->out2 = loop->out1;
    loop->out1 = loop->out;
    loop->err2 = loop->err1;
    loop->err1 = loop->err;
}
/**
  * @brief  SinglePhasePLLInit
  * @param  None
  * @return None
  * @note   锁相环初始化
*/
static void SinglePhasePLLInit(ClaType_t* value)
{
        value->pll.k1 = 1.0f;
        value->pll.k2 = 0.00001f;
        value->pll.kp = 1.43f;
        value->pll.ki = 200.0f;
        value->pll.cos0 = 1.0f;
        value->pll.sin0 = 0.0f;
        value->pll.cos1 = 1.0f;
        value->pll.sin1 = 0.0f;
        value->pll.theta = 0.0f;
        value->pll.theta1 = 0.0f;
}
/**
* @brief: SinglePhasePLL
* @param: static inline void
* @return:Nothing
* @note:锁相环
*/
static void SinglePhasePLL(ClaType_t* value)
{
    float32 pll_out_temp;
    //过零判断,计数及计数限幅
    if(((value->pll.input01 <= 0) && (value->value.instant > 0) && (value->pll.temp_cnt > 250.0f)) || (value->pll.temp_cnt > 666.0f))
    {
        value->pll.temp_cnt = VALUE_LIMIT(value->pll.temp_cnt, CLAdiv(1.0f,PLL_FREQ_MIN * TS) ,CLAdiv(1.0f,PLL_FREQ_MAX * TS));
        value->pll.cycle_time = value->pll.temp_cnt * TS;
        value->pll.temp_cnt = 0.0f;
    }
    else
    {
        value->pll.temp_cnt++;
    }
    //迭代
    value->pll.input01 = value->value.instant;
    //计算出频率,陷波角频率,目标角频率
    value->pll.freq = CLAdiv(1.0f, value->pll.cycle_time);
    value->pll.freq = VALUE_LIMIT(value->pll.freq, PLL_FREQ_MAX, PLL_FREQ_MIN);
    //TAG:频率自适应锁相环稳定性是个问号？TODO:更改为固定频率或者多周期平均值
    value->pll.wn = 2.0f * DOUBLE_PI * value->pll.freq;
    value->pll.w0 = DOUBLE_PI * value->pll.freq;

    //陷波器部分
    value->pll.a1 = value->pll.wn *value->pll.wn *TS *TS + 4.0f *TS *value->pll.k1 *value->pll.wn + 4.0f;
    value->pll.a2 = 2.0f *value->pll.wn *value->pll.wn *TS *TS - 8.0f;
    value->pll.a3 = value->pll.wn *value->pll.wn *TS *TS - 4.0f *TS *value->pll.k1 *value->pll.wn + 4.0f;
    value->pll.b1 = value->pll.wn *value->pll.wn *TS *TS + 4.0f *TS *value->pll.k2 *value->pll.wn + 4.0f;
    value->pll.b2 = 2.0f *value->pll.wn *value->pll.wn *TS *TS - 8.0f;
    value->pll.b3 = value->pll.wn *value->pll.wn *TS *TS - 4.0f *TS *value->pll.k2 *value->pll.wn + 4.0f;

    value->pll.upd0 = value->value.instant * value->pll.cos0;
    value->pll.y_notch0 = CLAdiv(value->pll.b1,value->pll.a1) *value->pll.upd0 + CLAdiv(value->pll.b2,value->pll.a1) *value->pll.upd1 + CLAdiv(value->pll.b3,value->pll.a1) *value->pll.upd2 - CLAdiv(value->pll.a2,value->pll.a1) *value->pll.y_notch1 - CLAdiv(value->pll.a3,value->pll.a1) *value->pll.y_notch2;
    //陷波器迭代
    value->pll.upd2 = value->pll.upd1;
    value->pll.upd1 = value->pll.upd0;
    //PI控制部分
    value->pll.a1 = -1.0f;
    value->pll.b0 =  (2.0f *value->pll.kp + value->pll.ki *TS) *0.5f;
    value->pll.b1 = -(2.0f *value->pll.kp - value->pll.ki *TS) *0.5f;
    value->pll.lpf0 = -1 *value->pll.a1 *value->pll.lpf1 + value->pll.b0 *value->pll.y_notch0 + value->pll.b1 *value->pll.y_notch1;
    pll_out_temp = 0.5f * value->pll.w0;
    if(value->pll.lpf0 > pll_out_temp)
    {
        value->pll.lpf0 = pll_out_temp;
    }
    else if(value->pll.lpf0 < -pll_out_temp)
    {
        value->pll.lpf0 = -pll_out_temp;
    }
    //PI迭代
    value->pll.lpf1 = value->pll.lpf0;
    value->pll.y_notch2 = value->pll.y_notch1;
    value->pll.y_notch1 = value->pll.y_notch0;
    //VCO部分
    value->pll.wo = value->pll.w0 + value->pll.lpf0;
    value->pll.sin0 = value->pll.sin1 + TS * value->pll.wo *value->pll.cos1;
    value->pll.cos0 = value->pll.cos1 - TS * value->pll.wo *value->pll.sin1;
    value->pll.sin0 = VALUE_LIMIT(value->pll.sin0, 0.9999f ,-0.9999f);
    value->pll.cos0 = VALUE_LIMIT(value->pll.cos0, 0.9999f ,-0.9999f);
    value->pll.theta = value->pll.theta1 + value->pll.wo * TS;
    if(value->pll.theta > DOUBLE_PI)
    {
        value->pll.theta = value->pll.theta - DOUBLE_PI;
    }
    else if(value->pll.theta < 0.0f)
    {
        value->pll.theta = value->pll.theta + DOUBLE_PI;
    }
    if((value->pll.sin0 > 0) && (value->pll.sin1 <= 0))
    {
        value->pll.theta = 0;
    }
    //迭代
    value->pll.theta1 = value->pll.theta;
    value->pll.sin1 = value->pll.sin0;
    value->pll.cos1 = value->pll.cos0;
    //输出sin值
    value->pll.output = value->pll.sin0;
}
/**
  * @brief  Phase_updata
  * @param  None
  * @retval None
  * @note   相位更新函数
*/
static void Phase_updata(void)
{
    // float32 delta_theta_ext;
    float32 delta_theta_eff;
    float32 theta_temp;
    float32 theta_sin;
    float32 delta_wn_temp;
    
    // delta_theta_ext = TS * INV_RADIAN_FREQ;
    /***********************************/
    //delta_wn计算
    if(gstSinCosSignal.theta_aim > DOUBLE_PI)
    {
        gstSinCosSignal.theta_aim = gstSinCosSignal.theta_aim - DOUBLE_PI;
    }
    if(gstSinCosSignal.theta_aim < 0.0f)
    {
        gstSinCosSignal.theta_aim = gstSinCosSignal.theta_aim + DOUBLE_PI;
    }
    delta_wn_temp = gstSinCosSignal.theta_aim - gstSinCosSignal.theta_eff;
    if(delta_wn_temp > PI)
    {
        delta_wn_temp = delta_wn_temp - DOUBLE_PI;
    }
    else if(delta_wn_temp < -PI)
    {
        delta_wn_temp = delta_wn_temp + DOUBLE_PI;
    }
    delta_wn_temp = delta_wn_temp * 10.0f;
    if(delta_wn_temp > DELTA_FREQ_MAX)
    {
        delta_wn_temp = DELTA_FREQ_MAX;
    }
    if(delta_wn_temp < -DELTA_FREQ_MAX)
    {
        delta_wn_temp = -DELTA_FREQ_MAX;
    }
    gstSinCosSignal.delta_wn = delta_wn_temp;
    /***********************************/

    /***********************************/
    //内部正弦信号更新
    //TAG:暂时无用屏蔽
    // theta_temp = gstSinCosSignal.theta_ext + delta_theta_ext;
    // if(theta_temp > DOUBLE_PI)
    // {
    //     theta_temp = theta_temp - DOUBLE_PI;
    // }
    // else if(theta_temp < 0.0f)
    // {
    //     theta_temp = theta_temp + DOUBLE_PI;
    // }
    // gstSinCosSignal.theta_ext = theta_temp; 
    //使用正弦函数更新
    // gstSinCosSignal.sin_ext[0] = SIN_USER(gstSinCosSignal.theta_ext);
    // gstSinCosSignal.cos_ext[0] = COS_USER(gstSinCosSignal.theta_ext);
    // gstSinCosSignal.sin_ext[1] = gstSinCosSignal.sin_ext[0]; 
    // gstSinCosSignal.cos_ext[1] = gstSinCosSignal.cos_ext[0]; 

    /***********************************/

    /***********************************/
    //生效参考信号更新
    gstSinCosSignal.wn_eff = gstSinCosSignal.wn_aim;
    delta_theta_eff = TS * (gstSinCosSignal.wn_eff + gstSinCosSignal.delta_wn);
    theta_temp = gstSinCosSignal.theta_eff + delta_theta_eff;
    if(theta_temp > DOUBLE_PI)
    {
        theta_temp = theta_temp - DOUBLE_PI;
    }
    else if(theta_temp < 0.0f)
    {
        theta_temp = theta_temp + DOUBLE_PI;
    }
    gstSinCosSignal.theta_eff = theta_temp; 
    theta_sin = gstSinCosSignal.theta_eff + gInvCurrentPhase;
    if(theta_sin > DOUBLE_PI)
    {
        theta_sin = theta_sin - DOUBLE_PI;
    }
    else if(theta_sin < 0.0f)
    {
        theta_sin = theta_sin + DOUBLE_PI;
    }
    gstSinCosSignal.sin_eff[0] = SIN_USER(theta_sin); //生效正弦信号为生效相角加上无功控制角的正弦值
    gstSinCosSignal.cos_eff[0] = COS_USER(theta_sin); //生效正弦信号为生效相角加上无功控制角的余弦值
    /***********************************/

    /***********************************/
    //离网参考信号更新
    gstSinCosSignal.sin_disconnect = gstSinCosSignal.sin_eff[0]; 
    gstSinCosSignal.cos_disconnect = gstSinCosSignal.cos_eff[0]; 
    gstSinCosSignal.theta_disconnect = gstSinCosSignal.theta_eff;
    gstSinCosSignal.wn_disconnect = INV_RADIAN_FREQ;
    /***********************************/

    /***********************************/
    //电网参考信号更新
    gstSinCosSignal.sin_grid = gstGrid.volt.pll.sin0;
    gstSinCosSignal.cos_grid = gstGrid.volt.pll.cos0;
    gstSinCosSignal.theta_grid = gstGrid.volt.pll.theta;
    gstSinCosSignal.wn_grid = gstGrid.volt.pll.wo;         
    //油机参考信号更新
    gstSinCosSignal.sin_generator = gstGenerator.volt.pll.sin0;
    gstSinCosSignal.cos_generator = gstGenerator.volt.pll.cos0;
    gstSinCosSignal.theta_generator = gstGenerator.volt.pll.theta;
    gstSinCosSignal.wn_generator = gstGenerator.volt.pll.wo; 
    /***********************************/
    

}
/**
* @brief: ADC_Instant
* @param: inline void
* @return:Nothing
* @note:赋值当本周期的瞬时值进入本周期计算
*/
inline void ADC_Instant_Update(void)
{

    gstGrid.volt.value.instant = gstAdcResult.grid_vol;       //市电电压
    gstGrid.curr.value.instant = gstAdcResult.Grid_curr;       //市电电流
    gstInv.volt.value.instant  = gstAdcResult.inv_volt;        //逆变电压
    gstInv.curr.value.instant  = -1.0f * gstAdcResult.inv_L_curr;        //逆变电感电流
    gstBackUp.volt.value.instant  = gstAdcResult.load_volt;        //负载电压
    gstBackUp.curr.value.instant  = gstAdcResult.load_current;        //负载电流
    gstCT.volt.value.instant  = gstAdcResult.grid_vol;        //
    gstCT.curr.value.instant  = gstAdcResult.ct_curr;        //
    gstNormalLoad.volt.value.instant  = gstAdcResult.grid_vol;        //
    gstNormalLoad.curr.value.instant  = gstCT.curr.value.instant - gstGrid.curr.value.instant;        //

    gstGenerator.volt.value.instant  = gstAdcResult.gen_volt;        //油机电压
    gstGenerator.curr.value.instant  = gstAdcResult.gen_curr;        //油机电流
    gstBusPos.volt.instant     = gstAdcResult.bus_volt_all;            //正负母线电压
    gstBusPos.curr.instant     = gstAdcResult.bus_curr;                 //母线电流
    gstBusNeg.volt.instant     = gstAdcResult.bus_volt_pn;            //PN母线电压
    gAddCur = gstAdcResult.inv_curr_tol - gstAdcResult.inv_L_curr; // 参考方向以流出为正

    /***********************************/
    //虚拟单相市电电压
    //50hz  一个开关周期为50us，一个工频周期20ms，对应2*pi 一共400个周期 每周期增加的角度为2*pi/400 = 0.015707963267
    //TODO:测试用，用完删除
    // grid_amp = 311.0f;
    
    /***********************************/
}
