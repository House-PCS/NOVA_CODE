/**
* @brief: InvWorkStateSwitch2
* @param: void
* @return:Nothing
* @note:逆变运行状态切换
*/
static void InvWorkStateSwitch2(void)
{
    switch(geInvControlStateCla)
    {
      case  INV_STATE_STANDBY:
      {
        if(geInvControlState == INV_STATE_SELFTEST)
        {
            geInvControlStateCla = INV_STATE_SELFTEST;
        }
        break;
      }
      case  INV_STATE_SELFTEST:
      {
        if(geInvControlState == INV_STATE_OPENING)
        {
            gstInvLoop.en_inv = 1;
            geInvControlStateCla = INV_STATE_OPENING;
        }
        else if(geInvControlState == INV_STATE_DISCONNECTED)
        {
            gstInvLoop.en_inv = 1;
            gInvDisconnectCount = DISCONNECTCOUNTTRIGG;
            geInvControlStateCla = INV_STATE_DISCONNECTED;
        }
        else if(geInvControlState != INV_STATE_SELFTEST)
        {
            geInvControlStateCla = INV_STATE_STANDBY;
        }
        break;
      }
      case  INV_STATE_OPENING:
      {
        if(geInvControlState != INV_STATE_OPENING)
        {
            geInvControlStateCla = INV_STATE_STANDBY;
        }
        break;
      }
      case  INV_STATE_SOFTSTARTING:
      {
        break;
      }
      case  INV_STATE_DISCONNECTED:
      {
        if(geInvControlState == INV_STATE_GRID_CONNECTING)
        {
            geInvControlStateCla = INV_STATE_GRID_CONNECTING;
        }
        else if(geInvControlState == INV_STATE_GEN_CONNECTING)
        {
            geInvControlStateCla = INV_STATE_GEN_CONNECTING;
        }
        else if(geInvControlState != INV_STATE_DISCONNECTED)
        {
            geInvControlStateCla = INV_STATE_STANDBY;
        }
        break;
      }
      case  INV_STATE_GRID_CONNECTING:
      {
        if(geInvControlState == INV_STATE_GRID_CONNECTED)
        {
            gstCurrentLoop.Kp = 3.5f;//TODO:参数确认
            // gstCurrentLoop.Ki = 0.0f;
            geInvControlStateCla = INV_STATE_GRID_CONNECTED;
        }
        else if(geInvControlState == INV_STATE_DISCONNECTED)
        {
            gInvDisconnectCount = DISCONNECTCOUNTTRIGG;
            geInvControlStateCla = INV_STATE_DISCONNECTED;
        }
        else if(geInvControlState != INV_STATE_GRID_CONNECTING)
        {
            geInvControlStateCla = INV_STATE_STANDBY;
        }

        break;
      }
      case  INV_STATE_GRID_CONNECTED:
      {
        if(geInvControlState == INV_STATE_GRID_DISCONNECTING)
        {
            gInvCurrentPhase = 0.0f; 
            gInvCurrAmpPI = 0.0f;
            gInvCurrThetaPI = 0.0f;
            gInvIdPI = 0.0f;
            gInvIqPI = 0.0f;
            geInvControlStateCla = INV_STATE_GRID_DISCONNECTING;
        }
        else if(geInvControlState != INV_STATE_GRID_CONNECTED)
        {
            geInvControlStateCla = INV_STATE_STANDBY;
        }
        break;
      }
      case  INV_STATE_GRID_DISCONNECTING:
      {
        if(geInvControlState == INV_STATE_DISCONNECTED)
        {
            gstCurrentLoop.Kp = 0.5f;
            // gstCurrentLoop.Ki = 0.0f;
            gInvDisconnectCount = 0.0f;
            geInvControlStateCla = INV_STATE_DISCONNECTED;
        }
        else if(geInvControlState != INV_STATE_GRID_DISCONNECTING)
        {
            geInvControlStateCla = INV_STATE_STANDBY;
        }
        break;
      }
      case  INV_STATE_GEN_CONNECTING:
      {
        if(geInvControlState == INV_STATE_GEN_CONNECTED)
        {
            gstCurrentLoop.Kp = 3.5f;//TODO:参数确认
            // gstCurrentLoop.Ki = 0.0f;
            geInvControlStateCla = INV_STATE_GEN_CONNECTED;
        }
        else if(geInvControlState == INV_STATE_DISCONNECTED)
        {
            gInvDisconnectCount = DISCONNECTCOUNTTRIGG;
            geInvControlStateCla = INV_STATE_DISCONNECTED;
        }
        else if(geInvControlState != INV_STATE_GEN_CONNECTING)
        {
            geInvControlStateCla = INV_STATE_STANDBY;
        }

        break;
      }
      case  INV_STATE_GEN_CONNECTED:
      {
        if(geInvControlState == INV_STATE_GEN_DISCONNECTING)
        {
            gInvCurrentPhase = 0.0f; 
            gInvCurrAmpPI = 0.0f;
            gInvCurrThetaPI = 0.0f;
            gInvIdPI = 0.0f;
            gInvIqPI = 0.0f;
            geInvControlStateCla = INV_STATE_GEN_DISCONNECTING;
        }
        else if(geInvControlState != INV_STATE_GEN_CONNECTED)
        {
            geInvControlStateCla = INV_STATE_STANDBY;
        }
        break;
      }
      case  INV_STATE_GEN_DISCONNECTING:
      {
        if(geInvControlState == INV_STATE_DISCONNECTED)
        {
            gstCurrentLoop.Kp = 0.5f;
            // gstCurrentLoop.Ki = 0.0f;
            gInvDisconnectCount = 0.0f;
            geInvControlStateCla = INV_STATE_DISCONNECTED;
        }
        else if(geInvControlState != INV_STATE_GEN_DISCONNECTING)
        {
            geInvControlStateCla = INV_STATE_STANDBY;
        }
        break;
      }
        default:
        {
            geInvControlStateCla = INV_STATE_STANDBY;
            break;
        }
    }
}
/**
* @brief: InvControl
* @param: void
* @return:Nothing
* @note:逆变控制
*/
static void InvControl(void)
{
    switch (geInvControlStateCla)
    {
        case INV_STATE_STANDBY://逆变待机状态
        {
            gInvCurrentPhase = 0.0f; //TODO: 参数确认
            gInvCurrAmpPI = 0.0f;
            gInvCurrThetaPI = 0.0f;
            gInvIdPI = 0.0f;
            gInvIqPI = 0.0f;
            // SinglePhasePwmUpDate(0.0f,0);
            InvLoopClear();
            gDuty_err = 0.0f;
            gstInvLoop.disconnect_volt.ref_amplitude = INV_VOL_NORMAL;
            if(gstInvInterface.clear_fault_cmd == 1)
            {
                // ClearErrState();
            }
            break;
        }
        case INV_STATE_SELFTEST://逆变自检状态
        {
            break;
        }
        case INV_STATE_OPENING://逆变开环状态
        {
            gstInvLoop.disconnect_volt.ref_amplitude = INV_VOL_NORMAL;
            gstSinCosSignal.theta_aim = gstSinCosSignal.theta_eff;
            gstSinCosSignal.wn_aim = INV_RADIAN_FREQ;
            SinglePhaseOpen(&gstGrid.volt);
            break;
        }
        case INV_STATE_SOFTSTARTING://逆变软起状态
        {

            break;
        }
        case INV_STATE_DISCONNECTED://逆变闭环状态
        {
            if(gInvTemp > 80.0f)
            {
                gstInvLoop.disconnect_volt.ref_amplitude = (INV_VOL_NORMAL - ((INV_VOL_NORMAL- 247.5f)*((gInvTemp-80.0f)*0.1))) ; //离网降额策略，当温度超过80度时，按照每升高1度降额10%的策略进行降额，最低不低于175Vrms对应的峰值247.5V
                if (gstInvLoop.disconnect_volt.ref_amplitude < 247.5f)
                {
                    gstInvLoop.disconnect_volt.ref_amplitude = 247.5f; //175Vrms对应247.5V峰值
                }
            }
            else if ((gInvTemp > 75.0f)&& (gInvTemp < 80.0f))
            {
                gstInvLoop.disconnect_volt.ref_amplitude += 0.000025f;
                if (gstInvLoop.disconnect_volt.ref_amplitude > INV_VOL_NORMAL)
                {
                    gstInvLoop.disconnect_volt.ref_amplitude = INV_VOL_NORMAL;
                }
            }
            else
            {
                gstInvLoop.disconnect_volt.ref_amplitude = INV_VOL_NORMAL;
            }
            // if(gstInvLoop.disconnect_volt.ref_amplitude > INV_VOL_NORMAL)
            // {
            //     gstInvLoop.disconnect_volt.ref_amplitude = INV_VOL_NORMAL;
            // }
            // else if(gstInvLoop.disconnect_volt.ref_amplitude < 170.0f)
            // {
            //     gstInvLoop.disconnect_volt.ref_amplitude = 170.0f;
            // }

            // gstInvLoop.disconnect_volt.ref_amplitude = INV_VOL_NORMAL;
            
            gstSinCosSignal.theta_aim = gstSinCosSignal.theta_eff;
            gstSinCosSignal.wn_aim = gstSinCosSignal.wn_disconnect;
            SinglePhaseClose();
            break;
        }    
        case INV_STATE_GRID_CONNECTING://逆变并网中状态
        {
            // gstInvLoop.disconnect_volt.ref_amplitude = gstGridData.vol_rms * 1.414f; 
            gstInvLoop.disconnect_volt.ref_amplitude += (gstGridData.vol_rms - gstInvData.vol_rms) * 0.00005f; 
            gstSinCosSignal.theta_aim = gstSinCosSignal.theta_grid;
            gstSinCosSignal.wn_aim = gstSinCosSignal.wn_grid;
            SinglePhaseClose();
            break;
        }
        case INV_STATE_GRID_CONNECTED://逆变已并网状态
        {
            // gstInvLoop.disconnect_volt.ref_amplitude = gstGridData.vol_rms * 1.414f; 
            gstSinCosSignal.theta_aim = gstSinCosSignal.theta_grid;
            gstSinCosSignal.wn_aim = gstSinCosSignal.wn_grid;
            SinglePhasePwrInterface(gstInvInterface.active_pwr_ref, gstInvInterface.reactive_pwr_ref, gstInvInterface.inv_cur_amp_max, 0U);
            SinglePhaseConnected(gInvCurrentRefAmp);
             
            break;
        }

        case INV_STATE_GRID_DISCONNECTING://逆变离网中状态
        {
            gInvCurrentRefAmp = gstBackUp.curr.value.rms * 1.414;
            gstSinCosSignal.theta_aim = gstSinCosSignal.theta_eff;
            gstSinCosSignal.wn_aim = gstSinCosSignal.wn_disconnect;
            SinglePhaseConnected(gInvCurrentRefAmp);
            gstInvLoop.disconnect_volt.ref_amplitude = gstGridData.vol_rms * 1.414f; 
            gstInvLoop.disconnect_volt.out1 = gstInvLoop.disconnect_curr.ref_real;
            gstInvLoop.disconnect_volt.out2 = gstInvLoop.disconnect_curr.ref_real;
            gstInvLoop.disconnect_volt.out = gstInvLoop.disconnect_curr.ref_real;
            gstInvLoop.disconnect_volt.err1 = 0.0f;
            gstInvLoop.disconnect_volt.err2 = 0.0f;
            gstInvLoop.disconnect_volt.err = 0.0f;
            break;
        }
        case INV_STATE_GEN_CONNECTING://油机并网中
        {
            gstInvLoop.disconnect_volt.ref_amplitude = gstGeneratorData.vol_rms * 1.414f; 
            gstSinCosSignal.theta_aim = gstSinCosSignal.theta_generator;
            gstSinCosSignal.wn_aim = gstSinCosSignal.wn_generator;
            SinglePhaseClose();
            break;
        }
        case INV_STATE_GEN_CONNECTED://油机并网
        {
            gstInvLoop.disconnect_volt.ref_amplitude = gstGeneratorData.vol_rms * 1.414f; 
            gstSinCosSignal.theta_aim = gstSinCosSignal.theta_generator;
            gstSinCosSignal.wn_aim = gstSinCosSignal.wn_generator;
            SinglePhasePwrInterface(gstInvInterface.active_pwr_ref, gstInvInterface.reactive_pwr_ref, gstInvInterface.inv_cur_amp_max, 1U);
            GEN_SinglePhaseConnected(gInvCurrentRefAmp);
             
            break;
        }

        case INV_STATE_GEN_DISCONNECTING://油机离网中状态
        {
            gInvCurrentRefAmp = gstBackUp.curr.value.rms * 1.414;
            gstSinCosSignal.theta_aim = gstSinCosSignal.theta_generator; 
            GEN_SinglePhaseConnected(gInvCurrentRefAmp);
            gstInvLoop.disconnect_volt.ref_amplitude = gstGridData.vol_rms * 1.414f; 
            gstInvLoop.disconnect_volt.out1 = gstInvLoop.disconnect_curr.ref_real;
            gstInvLoop.disconnect_volt.out2 = gstInvLoop.disconnect_curr.ref_real;
            gstInvLoop.disconnect_volt.out = gstInvLoop.disconnect_curr.ref_real;
            gstInvLoop.disconnect_volt.err1 = 0.0f;
            gstInvLoop.disconnect_volt.err2 = 0.0f;
            gstInvLoop.disconnect_volt.err = 0.0f;
            break;
        }
        default:
        {
            break;
        }

    }
}
/**
* @brief: Control_Init
* @param: void
* @return:Nothing
* @note:控制环路参数初始化
*/
static void Control_Init(void)
{
    if(gClaInitFinish == 0)
    {
        //TEST

        gstInvLoop.disconnect_volt.ref_amplitude = INV_VOL_NORMAL;
        //TODO:需增加并网环路初始化

        //离网电压环环路参数
        gstInvLoop.disconnect_curr.kp = 0.1f;
        gstInvLoop.disconnect_curr.ki = 500.0f;
        gstInvLoop.disconnect_curr.a1 = -1.0;
        gstInvLoop.disconnect_curr.b0 =  (2.0f * gstInvLoop.disconnect_curr.kp + gstInvLoop.disconnect_curr.ki * TS) * 0.5f;
        gstInvLoop.disconnect_curr.b1 = -(2.0f * gstInvLoop.disconnect_curr.kp - gstInvLoop.disconnect_curr.ki * TS) * 0.5f;
        //离网电流环环路参数
        gstInvLoop.disconnect_volt.kp = 0.10f;
        gstInvLoop.disconnect_volt.kr = 40.0f;
        gstInvLoop.disconnect_volt.wc = 3.14f;
        gstInvLoop.disconnect_volt.w0 = DOUBLE_PI * 50.0f ;
        gstInvLoop.disconnect_volt.a0 = CLAdiv(4.0f *gstInvLoop.disconnect_volt.kp,TS*TS) + CLAdiv(4.0f *gstInvLoop.disconnect_volt.wc *(gstInvLoop.disconnect_volt.kp + gstInvLoop.disconnect_volt.kr),TS) + gstInvLoop.disconnect_volt.kp *gstInvLoop.disconnect_volt.w0 *gstInvLoop.disconnect_volt.w0;
        gstInvLoop.disconnect_volt.a1 = CLAdiv(-8.0f *gstInvLoop.disconnect_volt.kp,TS*TS) + 2.0f * gstInvLoop.disconnect_volt.kp *gstInvLoop.disconnect_volt.w0 *gstInvLoop.disconnect_volt.w0;
        gstInvLoop.disconnect_volt.a2 = CLAdiv(4.0f *gstInvLoop.disconnect_volt.kp,TS*TS) - CLAdiv(4.0f *gstInvLoop.disconnect_volt.wc *(gstInvLoop.disconnect_volt.kp + gstInvLoop.disconnect_volt.kr),TS) + gstInvLoop.disconnect_volt.kp *gstInvLoop.disconnect_volt.w0 *gstInvLoop.disconnect_volt.w0;
        gstInvLoop.disconnect_volt.b0 = CLAdiv(4.0f ,TS*TS) + CLAdiv(4.0f *gstInvLoop.disconnect_volt.wc ,TS) + gstInvLoop.disconnect_volt.w0 *gstInvLoop.disconnect_volt.w0;
        gstInvLoop.disconnect_volt.b1 = CLAdiv(-8.0f ,TS*TS) + 2.0f *gstInvLoop.disconnect_volt.w0 *gstInvLoop.disconnect_volt.w0;
        gstInvLoop.disconnect_volt.b2 = CLAdiv(4.0f ,TS*TS) - CLAdiv(4.0f *gstInvLoop.disconnect_volt.wc ,TS) + gstInvLoop.disconnect_volt.w0 *gstInvLoop.disconnect_volt.w0;
        gstInvLoop.disconnect_volt.a0 = CLAdiv(gstInvLoop.disconnect_volt.a0,gstInvLoop.disconnect_volt.b0);
        gstInvLoop.disconnect_volt.a1 = CLAdiv(gstInvLoop.disconnect_volt.a1,gstInvLoop.disconnect_volt.b0);
        gstInvLoop.disconnect_volt.a2 = CLAdiv(gstInvLoop.disconnect_volt.a2,gstInvLoop.disconnect_volt.b0);
        gstInvLoop.disconnect_volt.b1 = CLAdiv(gstInvLoop.disconnect_volt.b1,gstInvLoop.disconnect_volt.b0);
        gstInvLoop.disconnect_volt.b2 = CLAdiv(gstInvLoop.disconnect_volt.b2,gstInvLoop.disconnect_volt.b0);
        gstInvLoop.disconnect_volt.Umax = INV_CUR_MAX;
        gstInvLoop.disconnect_volt.Umin = -1.0f*INV_CUR_MAX;
        gstInvLoop.en_inv = 0;
        //锁相环环路参数
        SinglePhasePLLInit(&gstGrid.volt);
        SinglePhasePLLInit(&gstGrid.curr);
        SinglePhasePLLInit(&gstInv.volt);
        SinglePhasePLLInit(&gstInv.curr);
        SinglePhasePLLInit(&gstGenerator.volt);
        SinglePhasePLLInit(&gstGenerator.curr);
        SinglePhasePLLInit(&gstCT.curr);
        SinglePhasePLLInit(&gstNormalLoad.curr);
        SinglePhasePLLInit(&gstBackUp.curr);
        AddPIControlerForwardInit(&gstVoltageLoop,0.02f,0.005f,20.0f,INV_CUR_MAX);
        AddPIControlerForwardInit(&gstCurrentLoop,0.5f,0.5f,10.0f,INV_VOL_MAX);
        geInvControlState = INV_STATE_SELFTEST;
        gstInv.volt.value.instant = 0;
        gstInv.curr.value.instant = 0;
        EPwm1Regs.TZCLR.bit.OST = 1;
        EPwm1Regs.TZOSTCLR.bit.OST1= 1;
        //正弦参考信号初始化
        gstSinCosSignal.sin_ext[0] = 0.0f;
        gstSinCosSignal.sin_ext[1] = 0.0f;
        gstSinCosSignal.cos_ext[0] = 1.0f;
        gstSinCosSignal.cos_ext[1] = 1.0f;
        gstSinCosSignal.theta_ext = 0.0f;

        gstSinCosSignal.sin_eff[0] = 0.0f;
        gstSinCosSignal.sin_eff[1] = 0.0f;
        gstSinCosSignal.cos_eff[0] = 1.0f;
        gstSinCosSignal.cos_eff[1] = 1.0f;
        gstSinCosSignal.theta_eff = 0.0f;
        gstSinCosSignal.wn_eff = INV_RADIAN_FREQ;

        gstSinCosSignal.wn_disconnect = INV_RADIAN_FREQ;
        //

        gInvCurrentPhase = 0.0f; 
        gInvCurrentRefAmp = 0.0f; 
        gInvCurrAmpPI = 0.0f;
        gInvCurrThetaPI = 0.0f;
        gInvIdPI = 0.0f;
        gInvIqPI = 0.0f;
        gDuty_err = 0.0f;
        /***********************************/
        //交流计算量初始化
        RmsPwrClaInit(&gstInvData, PWR_COMPUTE_FREQ, PWR_LOWEST_AC_FREQ, PWR_HIGHEST_AC_FREQ, PWR_COMPUTE_AC_PERIOD);
        RmsPwrClaInit(&gstBackUpData, PWR_COMPUTE_FREQ, PWR_LOWEST_AC_FREQ, PWR_HIGHEST_AC_FREQ, PWR_COMPUTE_AC_PERIOD);
        RmsPwrClaInit(&gstGeneratorData, PWR_COMPUTE_FREQ, PWR_LOWEST_AC_FREQ, PWR_HIGHEST_AC_FREQ, PWR_COMPUTE_AC_PERIOD);
        RmsPwrClaInit(&gstGridData, PWR_COMPUTE_FREQ, PWR_LOWEST_AC_FREQ, PWR_HIGHEST_AC_FREQ, PWR_COMPUTE_AC_PERIOD);
        RmsPwrClaInit(&gstCTData, PWR_COMPUTE_FREQ, PWR_LOWEST_AC_FREQ, PWR_HIGHEST_AC_FREQ, PWR_COMPUTE_AC_PERIOD);
        RmsPwrClaInit(&gstNormalLoadData, PWR_COMPUTE_FREQ, PWR_LOWEST_AC_FREQ, PWR_HIGHEST_AC_FREQ, PWR_COMPUTE_AC_PERIOD);
        /***********************************/
        gClaInitFinish = 1;
    }
}
/**
  * @brief  AlgoInterfaceUpdata
  * @param  None
  * @return None
  * @note   算法业务交互变量更新
*/
static void AlgoInterfaceUpdata(void)
{
    gstAlgoInterface.bus_vol = gstBusPos.volt.instant;    
    gstAlgoInterface.bus_cur = gstBusPos.curr.instant;
    /* bus_vol_rms、bus_cur_rms、bus2batpower、relay_middle_volt_phase_a_rms 由 CPU 侧 PwrCpuRelayBusStep 更新 */

    gstAlgoInterface.inv_vol = gstInv.volt.value.instant;
    gstAlgoInterface.inv_vol_ave = gstInv.volt.value.average;
    gstAlgoInterface.inv_cur = gstInv.curr.value.instant;
    gstAlgoInterface.grid_vol = gstGrid.volt.value.instant;
    gstAlgoInterface.grid_vol_ave = gstGrid.volt.value.average;
    gstAlgoInterface.grid_cur = gstGrid.curr.value.instant;
    gstAlgoInterface.generator_vol = gstGenerator.volt.value.instant;
    gstAlgoInterface.generator_cur = gstGenerator.curr.value.instant;
    gstAlgoInterface.generator_vol_ave = gstGenerator.volt.value.average;

    gstAlgoInterface.inv_freq = gstInv.volt.pll.freq;
    gstAlgoInterface.inv_vol_rms = gstInv.volt.value.rms;
    gstAlgoInterface.inv_cur_rms = gstInv.curr.value.rms;
    gstAlgoInterface.inv_active_power = gstInv.power.p;
    gstAlgoInterface.inv_reactive_power = gstInv.power.q;
    gstAlgoInterface.inv_apperant_power = gstInv.power.all;

    gstAlgoInterface.grid_freq = gstGrid.volt.pll.freq;   
    gstAlgoInterface.grid_vol_rms = gstGrid.volt.value.rms;
    gstAlgoInterface.grid_cur_rms = gstGrid.curr.value.rms;
    gstAlgoInterface.grid_active_power = gstGrid.power.p;
    gstAlgoInterface.grid_reactive_power = gstGrid.power.q;
    gstAlgoInterface.grid_apperant_power = gstGrid.power.all;

    gstAlgoInterface.generator_freq =  gstGenerator.volt.pll.freq;                                   
    gstAlgoInterface.generator_vol_rms = gstGenerator.volt.value.rms;
    gstAlgoInterface.generator_cur_rms = gstGenerator.curr.value.rms;
    gstAlgoInterface.generator_active_power = gstGenerator.power.p;
    gstAlgoInterface.generator_reactive_power = gstGenerator.power.q;
    gstAlgoInterface.generator_apperant_power = gstGenerator.power.all;

    gstAlgoInterface.load_vol_rms = gstBackUp.volt.value.rms;
    gstAlgoInterface.load_cur_rms = gstBackUp.curr.value.rms;
    gstAlgoInterface.load_active_power = gstBackUp.power.p;
    gstAlgoInterface.load_reactive_power = gstBackUp.power.q_filter;
    gstAlgoInterface.load_apperant_power = gstBackUp.power.all;

    gstAlgoInterface.ct_vol_rms = gstCT.volt.value.rms;
    gstAlgoInterface.ct_cur_rms = gstCT.curr.value.rms;
    gstAlgoInterface.ct_active_power = gstCT.power.p;
    gstAlgoInterface.ct_reactive_power = gstCT.power.q;
    gstAlgoInterface.ct_apperant_power = gstCT.power.all;

    gstAlgoInterface.normalload_vol_rms = gstNormalLoad.volt.value.rms;
    gstAlgoInterface.normalload_cur_rms = gstNormalLoad.curr.value.rms;
    gstAlgoInterface.normalload_active_power = gstNormalLoad.power.p;
    gstAlgoInterface.normalload_reactive_power = gstNormalLoad.power.q;
    gstAlgoInterface.normalload_apperant_power = gstNormalLoad.power.all;

    gstAlgoInterface.inv_vol_theta = gstInv.volt.pll.theta;
    gstAlgoInterface.grid_vol_theta = gstGrid.volt.pll.theta;
    gstAlgoInterface.grid_vol_sin = gstGrid.volt.pll.sin0;
    gstAlgoInterface.generator_vol_theta = gstGenerator.volt.pll.theta;
    // if(geInvControlStateCla == INV_STATE_GRID_CONNECTED)
    // {
    //     gstAlgoInterface.grid_connect = 1; 
    // }
    // else
    // {
    //     gstAlgoInterface.grid_connect = 0; 
    // }
    gstAlgoInterface.inv_state = geInvControlStateCla;
    gstAlgoInterface.inv_start_ok = gstInvLoop.inv_start_ok;

}
/**
* @brief: ADC_Int2
* @param: static void
* @return:Nothing
* @note:所有与ADC相关的函数均放在ADC_Int1()上方写完
*/
static void ADC_Int2(void)
{
    ADC_Instant_Update();   //赋值本周期参与计算的瞬时值

}
/**
* @brief: PLL_Int2
* @param: static void
* @return:Nothing
* @note:所有与PLL相关的函数均放在PLL_Int2()上方写完
*/
static void PLL_Int2(void)
{
    SinglePhasePLL(&gstGrid.volt); //运行时间1.63us
    SinglePhasePLL(&gstInv.volt);
    SinglePhasePLL(&gstGenerator.volt);
    // SetClaDebugData(1,gstGrid.volt.value.instant);
    // SetClaDebugData(2,gstGrid.volt.pll.output *311.0f);
}
/**
* @brief: Inv_Int2
* @param: static void
* @return:Nothing
* @note:所有与Inv相关的函数均放在Inv_Int2()上方写完
*/
static void Inv_Int2(void)
{    
       
    /* InvWorkStateSwitch2(); */     //逆变状态机,决策当前逆变器状态,TODO:决策放在CPU中进行
    InvControl();               //逆变控制
    SinglePhasePwmUpDate(gstInvLoop.duty ,gstInvLoop.en_inv);
}
/**
* @brief: CLA_Task
* @param: static inline void
* @return:Nothing
* @note:所有CLA工程函数加入此函数（最终加入到CLA_TASK的总函数）
*/
inline void CLA_Task(void)
{

//    float32 cla_time;
//    float32 cla_time_next;
//    cla_time = ECap1Regs.TSCTR;
    /*Control_Init();   */ //初始化已迁移至CPU侧
    ADC_Int2();
    PLL_Int2();
    Phase_updata(); //TODO:放在这里目标相位变化会滞后一个控制周期，后续需考虑放在控制环路里还是状态机里
    Inv_Int2();
    AlgoInterfaceUpdata();
    RmsCompute();

    // cla_time_next = ECap1Regs.TSCTR;
    // if(cla_time > cla_time_next)
    // {
    //     gClaRunTime = cla_time_next + (0xffffffffUL - cla_time);
    // }
    // else
    // {
    //     gClaRunTime = cla_time_next - cla_time;
    // }

    ClearClaInterrupt();//清除中断标志位,新增函数需放在这里上方
}

__attribute__((interrupt)) void Cla1Task1 (void)
{
    GpioDataRegs.GPCSET.bit.GPIO94 = 1;
    CLA_Task();
    GpioDataRegs.GPCCLEAR.bit.GPIO94 = 1;
}
