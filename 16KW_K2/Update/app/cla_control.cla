/**
  * @brief  SinglePhasePwrInterface  (合并原 Grid / Gen 两个接口函数)
  * @param  pwr_active_ref    有功参考 (W)
  * @param  pwr_reactive_ref  无功参考 (Var)
  * @param  cur_amp_max       电流幅值限幅 (A峰值)
  * @param  is_gen            0 = 电网并网模式，1 = 油机并网模式
  * @note   Grid 模式：含负载补偿、容性补偿、功率缓起，clamp ±20A
  *         Gen  模式：无补偿/缓起，clamp ±cur_amp_max，有功参考不允许负值
*/
static void SinglePhasePwrInterface(float32 pwr_active_ref, float32 pwr_reactive_ref,
                                     float cur_amp_max, uint16_t is_gen)
{
    /* 各模式独立的上一拍功率记忆，防止模式切换时串扰 */
    static float32 pwr_active_up_grid;
    static float32 pwr_active_up_gen;
    /* Grid 模式的功率缓起状态 */
//    static float32 pwr_inv_active_ref_ramp;
//    static float32 pwr_inv_reactive_ref_ramp;

    float32 pwr_active;
    float32 pwr_reactive;
    float32 act_pwr_diff;
    float32 react_pwr_diff;
    float32 id_diff;
    float32 iq_diff;
    float32 id_ref;
    float32 iq_ref;
    float32 amp_ref;
    float32 theta_ref;
    float32 vol_rms;
    float32 pwr_inv_active_ref;
    float32 pwr_inv_reactive_ref;

    vol_rms = gstInv.volt.value.rms;

    if(is_gen == 1)  /* ---- 油机并网模式 ---- */
    {
        if(pwr_active_ref < 0.0f) pwr_active_ref = 0.0f;
    }

    pwr_inv_active_ref   = -(pwr_active_ref  + gstBackUp.power.p);
    pwr_inv_reactive_ref = -(pwr_reactive_ref + gstBackUp.power.q_filter
                              + vol_rms * vol_rms * INV_Y_CAP
                              + gstInvInterface.reactive_pwr_compute);
    
    //pwr_inv_reactive_ref = -(pwr_reactive_ref + vol_rms * vol_rms * INV_Y_CAP + gstInvInterface.reactive_pwr_compute);

    if(is_gen == 0)  /* ---- 电网并网模式 ---- */
    {
        pwr_active   = gstGrid.power.p;
        pwr_reactive = gstGrid.power.q;
    }
    if(is_gen == 1)
    {
        pwr_active   = gstGenerator.power.p;
        pwr_reactive = gstGenerator.power.q;
    }

    act_pwr_diff   = -1.0f * (pwr_active_ref  - pwr_active);
    react_pwr_diff = -1.0f * (pwr_reactive_ref - pwr_reactive);

    // pwr_inv_active_ref_ramp   = RampFunction(pwr_inv_active_ref,   INV_PWR_REF_RAMP_SPEED, pwr_inv_active_ref_ramp);
    // pwr_inv_reactive_ref_ramp = RampFunction(pwr_inv_reactive_ref, INV_PWR_REF_RAMP_SPEED, pwr_inv_reactive_ref_ramp);

    if(((is_gen == 0) && (pwr_active_up_grid != pwr_active))
        || ((is_gen == 1) && (pwr_active_up_gen != pwr_active)))
    {
        id_diff = act_pwr_diff   / vol_rms * GRID_DELTA_ACTIVE;
        iq_diff = react_pwr_diff / vol_rms * GRID_DELTA_REACTIVE;
    }
    else
    {
        id_diff = 0.0f;
        iq_diff = 0.0f;
    }

    if(is_gen == 0) pwr_active_up_grid = pwr_active;
    if(is_gen == 1) pwr_active_up_gen  = pwr_active;

    gInvIdPI += id_diff;
    gInvIqPI += iq_diff;
    if(gInvIdPI >  20.0f)      gInvIdPI =  20.0f;
    else if(gInvIdPI < -20.0f) gInvIdPI = -20.0f;
    if(gInvIqPI >  20.0f)      gInvIqPI =  20.0f;
    else if(gInvIqPI < -20.0f) gInvIqPI = -20.0f;

    // id_ref = pwr_inv_active_ref_ramp   / vol_rms * 1.414f + gInvIdPI;
    // iq_ref = pwr_inv_reactive_ref_ramp / vol_rms * 1.414f + gInvIqPI;

    id_ref = pwr_inv_active_ref   / vol_rms * 1.414f + gInvIdPI;
    iq_ref = pwr_inv_reactive_ref / vol_rms * 1.414f + gInvIqPI;

    /* ---- 公共尾段：dq → 幅值 / 相角 ---- */
    amp_ref = CLAsqrt(id_ref * id_ref + iq_ref * iq_ref);
    if(amp_ref > cur_amp_max) amp_ref = cur_amp_max;

    if(fabs(iq_ref) >= amp_ref)
    {
        theta_ref = (iq_ref > 0.0f) ? HALF_PI : -HALF_PI;
    }
    else
    {
        theta_ref = CLAasin(iq_ref / amp_ref);
    }
    if(id_ref < 0.0f)
    {
        theta_ref = (iq_ref < 0.0f) ? (-PI - theta_ref) : (PI - theta_ref);
    }

    gInvCurrentPhase  = -theta_ref;
    gInvCurrentRefAmp = amp_ref;
    gInvIdRef = id_ref;
    gInvIqRef = iq_ref;
}
/**
  * @brief  SinglePhaseConnected
  * @param  iref:给定电流
  * @return None
  * @note   单相逆变器离网控制
*/
static void SinglePhaseConnected(float iref_amp)
{

    float32 vol_out = 0;
    float32 bus_vol = gstBusPos.volt.instant;
    float32 forward = 0.0f;
    float32 ic_forward = 0.0f;
    VoltRefAmpUpdata(); //电压给定更新
    gstInvLoop.disconnect_curr.ref_amplitude = iref_amp;
    if((gstSinCosSignal.sin_eff[0] < 0.05f) && (gstSinCosSignal.sin_eff[0] > -0.05f))//TODO:过零点生效
    {
        gstInvLoop.disconnect_curr.ref_amplitude_eff =gstInvLoop.disconnect_curr.ref_amplitude;     
    }
    gstInvLoop.disconnect_curr.ref_real = gstInvLoop.disconnect_curr.ref_amplitude_eff * gstSinCosSignal.sin_eff[0];
    ic_forward = -2.5f * gAddCur;
    if(ic_forward > 5.0f)
    {
        ic_forward = 5.0f;
    }
    if(ic_forward < -5.0f)
    {
        ic_forward = -5.0f;
    }
    forward = ic_forward + gstGrid.volt.value.instant; 
    vol_out = PIControlerForward(&gstCurrentLoop, gstInvLoop.disconnect_curr.ref_real, gstInv.curr.value.instant, forward);
    gstInvLoop.duty = CLAdiv(vol_out, bus_vol); 
}

/**
  * @brief  GEN_SinglePhaseConnected
  * @param  iref:给定电流
  * @return None
  * @note   油机并网控制环路
*/
static void GEN_SinglePhaseConnected(float iref_amp)
{

    float32 vol_out = 0;
    float32 bus_vol = gstBusPos.volt.instant;
    float32 forward = 0.0f;
    float32 ic_forward = 0.0f;
    VoltRefAmpUpdata(); //电压给定更新
    gstInvLoop.disconnect_curr.ref_amplitude = iref_amp;
    if((gstSinCosSignal.sin_eff[0] < 0.05f) && (gstSinCosSignal.sin_eff[0] > -0.05f))//TODO:过零点生效
    {
        gstInvLoop.disconnect_curr.ref_amplitude_eff =gstInvLoop.disconnect_curr.ref_amplitude;     
    }
    gstInvLoop.disconnect_curr.ref_real = gstInvLoop.disconnect_curr.ref_amplitude_eff * gstSinCosSignal.sin_eff[0];
    ic_forward = -2.5f * gAddCur;
    if(ic_forward > 5.0f)
    {
        ic_forward = 5.0f;
    }
    if(ic_forward < -5.0f)
    {
        ic_forward = -5.0f;
    }
    forward = ic_forward + gstGenerator.volt.value.instant; 
    vol_out = PIControlerForward(&gstCurrentLoop, gstInvLoop.disconnect_curr.ref_real, gstInv.curr.value.instant, forward);
    gstInvLoop.duty = CLAdiv(vol_out, bus_vol); 
}


