        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="HfS9wEGhKrr5IdP-FBBe-3" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
          <mxGeometry x="364.13" y="80" width="551.74" height="240" as="geometry" />
        </mxCell>
        <mxCell id="HfS9wEGhKrr5IdP-FBBe-37" value="&lt;h1&gt;说明&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;DeviceType：&lt;/b&gt;0x00，逆变器模块；0x01，PACK模块。&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Reserved：&lt;/b&gt;预留字节，默认0x00。&lt;br&gt;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;OpCmd&lt;/b&gt;：0x45，写操作；0x43，读操作。&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font size=&quot;3&quot;&gt;&lt;b&gt;Addr&lt;/b&gt;：32bit地址，表征操作寄存器地址。&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font size=&quot;3&quot;&gt;&lt;b&gt;Length&lt;/b&gt;：表征用户数据有效总长度，参考UDP协议中数据长度，用户数据有效总长度为用 &lt;b&gt;用户数据首部 + 用户负载有效数据&lt;/b&gt;。当用户负载有效数据个数小于8时，需要通过补充0x00，确保用户数据最小长度大于等于18。&lt;/font&gt;&lt;/p&gt;" style="text;html=1;strokeColor=default;fillColor=none;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="120" y="590" width="1001" height="220" as="geometry" />
        </mxCell>
        <mxCell id="_UtGra1sZkw2GHE9GwzL-1" value="" style="endArrow=classic;startArrow=classic;html=1;rounded=0;" parent="1" edge="1">
