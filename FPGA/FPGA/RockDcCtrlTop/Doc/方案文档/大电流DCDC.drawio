  <diagram id="uFyx0VHVYI5_r9YF4-My" name="百兆网UDP通信协议格式">
    <mxGraphModel dx="1418" dy="1628" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
